[TEMPLATE]
# Eclipse Moderation Bot — environment configuration.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# never commit it. Alternatively, export the variables in your shell.

# --- Discord (required) ---
# Bot token from https://discord.com/developers/applications -> your app -> Bot.
DISCORD_TOKEN=your_discord_bot_token_here

# --- Logging (optional) ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
RIYXOEN_LOG_LEVEL=INFO
# Optional path to a log file (its directory is created if needed).
# Leave unset to log to the console only.
RIYXOEN_LOG_FILE=logs/eclipse.log

# --- Runtime (optional) ---
# Seconds to wait for a graceful client.close() during shutdown.
RIYXOEN_SHUTDOWN_TIMEOUT_SECONDS=10

# --- Intents (optional) ---
# The privileged message_content intent. It is ON by default:
# the prefix commands (.el, .ban, .kick, .mute, .unmute) and the automated
# moderation detectors read message text, so this intent is required for the
# features this bot ships. Set to 0 to opt out (prefix commands then no-op
# with a logged warning). It must also be enabled in the Discord developer
# portal (Bot -> Privileged Gateway Intents -> Message Content Intent) or the
# gateway rejects the connection.
# The privileged members intent is always required for moderation and cannot
# be disabled here.
RIYXOEN_ENABLE_MESSAGE_CONTENT_INTENT=1

# --- Prefix commands (optional) ---
# Prefix for the text commands: .el enable / .el rename / .el color / .ban /
# .kick / .mute / .unmute. 1-3 non-space characters; default ".".
RIYXOEN_COMMAND_PREFIX=.

# --- Moderation (optional) ---
# Comma-separated Discord role IDs that may run every moderation command,
# regardless of Discord permissions. Leave empty to rely on permissions only.
# Example: RIYXOEN_MODERATOR_ROLE_IDS=123456789012345678,987654321098765432
RIYXOEN_MODERATOR_ROLE_IDS=
# Optional Discord channel ID that receives a case summary per action.
# Leave empty to disable.
RIYXOEN_LOG_CHANNEL_ID=
# Set to 0 to disable DM notifications to punished users.
RIYXOEN_NOTIFY_USERS=1
# Maximum messages a single /purge may delete (1-1000).
RIYXOEN_MAX_PURGE_AMOUNT=100

# --- Persistence (optional) ---
# Local SQLite file for case records. The file and its directory are
# git-ignored; it must never be committed. Relative paths resolve from the
# working directory the bot is started from.
RIYXOEN_DATABASE_PATH=data/cases.db

# --- Automated moderation (optional; OFF by default) ---
# The engine is opt-in: set to 1 to enable spam/duplicate/mention/link/
# word-filter detection. Enabling this also turns on the message_content
# intent (see above) — enable it in the developer portal too. All thresholds
# are conservative; 0 disables an individual mention dimension; escalation
# and blocked terms are empty until you configure them.
#
# These values are the *global defaults* that seed every server's
# per-guild configuration. Servers override them at runtime through the
# /config slash commands (stored in the local SQLite database, never in this
# file). RIYXOEN_AUTOMOD_ENABLED stays the master switch — it also drives
# the message_content intent — while /config moderation automod toggles it
# per server.
RIYXOEN_AUTOMOD_ENABLED=0

# Spam: N messages within N seconds -> action (delete|warn|timeout).
RIYXOEN_AUTOMOD_SPAM_THRESHOLD=5
RIYXOEN_AUTOMOD_SPAM_WINDOW_SECONDS=5
RIYXOEN_AUTOMOD_SPAM_ACTION=delete

# Duplicate messages: N identical (normalized) messages within N seconds.
# Minimum threshold is 2; a single repeated message never triggers.
RIYXOEN_AUTOMOD_DUPLICATE_THRESHOLD=4
RIYXOEN_AUTOMOD_DUPLICATE_WINDOW_SECONDS=30
RIYXOEN_AUTOMOD_DUPLICATE_ACTION=delete

# Mentions: independent thresholds for user / role / total / @everyone+@here.
# 0 disables that dimension. @everyone/@here is OFF by default because
# Discord permissions already gate it.
RIYXOEN_AUTOMOD_MENTION_USER_THRESHOLD=10
RIYXOEN_AUTOMOD_MENTION_ROLE_THRESHOLD=6
RIYXOEN_AUTOMOD_MENTION_TOTAL_THRESHOLD=15
RIYXOEN_AUTOMOD_MENTION_EVERYONE_THRESHOLD=0
RIYXOEN_AUTOMOD_MENTION_ACTION=delete

# Links: allow|delete|warn|timeout. "allow" (default) does not enforce.
# Allowed domains: comma-separated, matched exactly or as proper subdomains
# (github.com allows api.github.com but never evilgithub.com).
RIYXOEN_AUTOMOD_LINK_ACTION=allow
RIYXOEN_AUTOMOD_ALLOWED_DOMAINS=

# Word filter: comma-separated blocked terms (never hardcoded in source).
# Whole-word matching by default ("ass" won't match "assessment"); set
# substring mode to 1 to explicitly opt into substring matching.
RIYXOEN_AUTOMOD_BLOCKED_TERMS=
RIYXOEN_AUTOMOD_BLOCKED_TERMS_SUBSTRING=0
RIYXOEN_AUTOMOD_WORD_FILTER_ACTION=delete

# Exemptions: comma-separated user/role/channel IDs that bypass detection.
# Moderators, the server owner, and bots are always exempt.
RIYXOEN_AUTOMOD_EXEMPT_USER_IDS=
RIYXOEN_AUTOMOD_EXEMPT_ROLE_IDS=
RIYXOEN_AUTOMOD_EXEMPT_CHANNEL_IDS=

# Enforcement cooldown: seconds to wait before enforcing again for the same
# (guild, user) after a detection. 0 disables the cooldown (not recommended).
RIYXOEN_AUTOMOD_ENFORCEMENT_COOLDOWN_SECONDS=60

# Warning escalation: when a detector action is "warn", escalate to a timeout
# once the member's ACTIVE warnings (successful warn cases within the warning
# window) reach a threshold. Format: count:seconds,count:seconds, sorted by
# count. Example: 3:3600,5:43200 (3rd warning -> 1h timeout, 5th -> 12h).
# Warning expiration: warnings stop counting after WARNING_WINDOW_SECONDS;
# 0 means warnings never expire.
RIYXOEN_AUTOMOD_WARNING_WINDOW_SECONDS=604800
RIYXOEN_AUTOMOD_ESCALATION=

# --- Invites ---
# Invite filtering: allow|delete|warn|timeout. "allow" (default) does not
# enforce. Allowed invite codes: comma-separated codes that bypass the
# filter (server owners whitelist their own invites, e.g. "welcome,join-us").
RIYXOEN_AUTOMOD_INVITE_ACTION=allow
RIYXOEN_AUTOMOD_INVITE_ALLOWED_CODES=

# --- Raid protection (conservative) ---
# Detects unusual join bursts: N joins within N seconds. The default action
# is "alert" (a notice to the configured log channel) — never an automatic
# punishment. "timeout" is opt-in and applies the default timeout duration
# to members who joined within the window. Ban/kick are NEVER raid actions.
RIYXOEN_AUTOMOD_RAID_JOIN_THRESHOLD=10
RIYXOEN_AUTOMOD_RAID_WINDOW_SECONDS=10
RIYXOEN_AUTOMOD_RAID_ACTION=alert
